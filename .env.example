# ==============================================================================
# MOERGE — Salon Appointment Reminder & Booking System Configuration
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local or expose server-only keys in client code.
# ==============================================================================

# 1. Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# Server-only Supabase Service Role Key (Required for cron worker, webhooks, and rate limiting)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 2. Resend Email Delivery Configuration (Server-only)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Resend Webhook Signing Secret (Server-only)
# Obtain from https://resend.com/webhooks (starts with whsec_)
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 3. Scheduled Job / Cron Security (Server-only)
# Used to authenticate Vercel Cron or Supabase pg_cron requests to /api/cron/process-reminders
CRON_SECRET="replace-with-a-strong-random-secret-string"

# 4. Cloudflare Turnstile Bot Protection (Server-only, optional in local dev)
# Obtain from Cloudflare Dashboard -> Turnstile
TURNSTILE_SECRET_KEY=""

# 5. Application URL & Development / Testing Mode
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set EMAIL_DRY_RUN="true" in development to simulate email sending without emailing real clients
EMAIL_DRY_RUN="true"

# Optional override: redirect all outgoing emails in non-production to a safe test inbox
EMAIL_TEST_RECIPIENT=""

# 6. Test Suite Staff Credentials (Optional: used by vitest for authenticated staff RLS tests)
TEST_STAFF_EMAIL=""
TEST_STAFF_PASSWORD=""
